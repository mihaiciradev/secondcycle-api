# SecondCycle API environment. Copy to .env and fill in.
# NEVER commit a real .env. All values below are blank on purpose.

# --- Environment -------------------------------------------------------------
# local | staging | production | test
ENVIRONMENT=local

# --- Database (Neon) ---------------------------------------------------------
# IMPORTANT: two URLs.
#  DATABASE_URL        -> the POOLED connection string (PgBouncer, transaction
#                         mode). Used by the app. asyncpg prepared-statement
#                         caching is disabled in code (statement_cache_size=0).
#  DATABASE_URL_DIRECT -> the DIRECT (unpooled) connection string. Used ONLY by
#                         Alembic migrations. Running migrations through the
#                         pooler breaks.
# Both use the asyncpg driver: postgresql+asyncpg://USER:PASS@HOST/DB?sslmode=require
DATABASE_URL=
DATABASE_URL_DIRECT=

# --- Auth / JWT --------------------------------------------------------------
# Must be at least 32 bytes. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Google Sign-In: the OAuth client id used as the token audience.
GOOGLE_CLIENT_ID=

# --- CORS --------------------------------------------------------------------
# Comma-separated exact origins. Never "*" with credentials.
CORS_ORIGINS=https://www.secondcycle.ro

# --- Email (Resend) ----------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=SecondCycle <no-reply@secondcycle.ro>
# Public site origin used to build links inside emails.
FRONTEND_BASE_URL=https://www.secondcycle.ro

# --- Cloudflare R2 (S3 API) --------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# e.g. https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=

# --- Seed admin (python -m app.seed) -----------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
